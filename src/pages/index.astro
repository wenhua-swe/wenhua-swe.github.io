---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import BookCard from '../components/BookCard.astro';
import PhotoFigure from '../components/PhotoFigure.astro';
import PhotoCard from '../components/PhotoCard.astro';
import Lightbox from '../components/Lightbox.astro';
import { photos } from '../data/photos';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getBlogPosts, getBookPosts } from '../lib/content';

const books = (await getBookPosts()).slice(0, 3);
const posts = (await getBlogPosts()).slice(0, 6);
// Number the sections that are actually shown, so an empty one leaves no gap
const shown = [...(books.length > 0 ? ['books'] : []), 'blog', 'photos'];
const no = (section: string) => String(shown.indexOf(section) + 1).padStart(2, '0');
const heroPhoto = photos.find((p) => p.file === 'dscf0420')!;
const featured = ['dscf0923', 'dscf0274', 'dscf1152', 'dscf0985'].map((f) => photos.find((p) => p.file === f)!);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class='container hero'>
    <div class='mono muted'>[ 00 — 閱讀、寫程式、拍照 ]</div>
    <div class='hero-grid'>
      <h1 class='display'>Notes from <em>the margin</em><span class='accent'>.</span></h1>
      <p class='muted'>{SITE_DESCRIPTION}</p>
    </div>
    <div class='hero-photo'>
      <PhotoFigure photo={heroPhoto} sizes='(max-width: 1264px) 100vw, 1200px' eager />
    </div>
  </section>

  {
    books.length > 0 && (
      <section class='container block'>
        <div class='section-head'>
          <h2>
            <em>{no('books')}</em> 閱讀筆記
          </h2>
          <a href='/books' class='mono'>
            全部筆記 →
          </a>
        </div>
        <div class='books'>
          {books.map((post) => (
            <BookCard post={post} />
          ))}
        </div>
      </section>
    )
  }

  <section class='container block'>
    <div class='section-head'>
      <h2><em>{no('blog')}</em> 技術和生活</h2>
      <a href='/blog' class='mono'>全部文章 →</a>
    </div>
    <div>
      {posts.map((post) => <PostRow post={post} />)}
    </div>
  </section>

  <section class='container block'>
    <div class='section-head'>
      <h2><em>{no('photos')}</em> 攝影</h2>
      <a href='/photos' class='mono'>全部作品 →</a>
    </div>
    <div class='photos'>
      {featured.map((photo) => (
        <PhotoCard photo={photo} sizes='(max-width: 720px) 50vw, (max-width: 1264px) 25vw, 290px' />
      ))}
    </div>
  </section>
  <Lightbox />
</BaseLayout>

<style>
  .hero {
    padding-top: 64px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: end;
    margin-top: 28px;
  }
  h1 {
    grid-column: span 8;
    margin: 0;
    font-size: clamp(40px, 7vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .hero-grid p {
    grid-column: span 4;
    margin: 0;
    line-height: 1.9;
  }
  .hero-photo {
    margin-top: 40px;
  }
  /* Wide crop for the banner */
  .hero-photo :global(.open) {
    aspect-ratio: 21 / 8 !important;
    border-radius: 20px;
  }
  .block {
    margin-top: 96px;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .block .section-head {
    margin-bottom: 28px;
  }
  .books {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  @media (max-width: 860px) {
    h1,
    .hero-grid p {
      grid-column: 1 / -1;
    }
    .photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 12px;
    }
    .hero-photo :global(.open) {
      aspect-ratio: 4 / 3 !important;
    }
    .books {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .books {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
