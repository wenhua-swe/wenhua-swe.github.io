---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import BookCard from '../components/BookCard.astro';
import PhotoFigure from '../components/PhotoFigure.astro';
import Lightbox from '../components/Lightbox.astro';
import { photos } from '../data/photos';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getBlogPosts, getBookPosts } from '../lib/content';

const books = (await getBookPosts()).slice(0, 3);
const posts = (await getBlogPosts()).slice(0, 6);
const heroPhoto = photos.find((p) => p.file === 'dscf0420')!;
const featured = ['dscf0923', 'dscf0274', 'dscf1152', 'dscf0523'].map((f) => photos.find((p) => p.file === f)!);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class='container hero'>
    <div class='mono muted'>[ 00 — 讀書、寫程式、拍照 ]</div>
    <div class='hero-grid'>
      <h1 class='display'>Notes from <em>the margin</em><span class='accent'>.</span></h1>
      <p class='muted'>{SITE_DESCRIPTION}</p>
    </div>
    <div class='hero-photo'>
      <PhotoFigure photo={heroPhoto} sizes='(max-width: 1264px) 100vw, 1200px' caption={false} eager />
    </div>
  </section>

  <section class='container block'>
    <div class='section-head'>
      <h2><em>01</em> 讀書心得</h2>
      <a href='/books' class='mono'>全部書單 →</a>
    </div>
    {
      books.length > 0 ? (
        <div class='books'>
          {books.map((post) => (
            <BookCard post={post} />
          ))}
        </div>
      ) : (
        <p class='empty muted'>第一篇心得正在寫，敬請期待。</p>
      )
    }
  </section>

  <section class='container block'>
    <div class='section-head'>
      <h2><em>02</em> 技術筆記</h2>
      <a href='/blog' class='mono'>全部文章 →</a>
    </div>
    <div>
      {posts.map((post) => <PostRow post={post} />)}
    </div>
  </section>

  <section class='container block'>
    <div class='section-head'>
      <h2><em>03</em> 攝影</h2>
      <a href='/photos' class='mono'>全部作品 →</a>
    </div>
    <div class='photos'>
      <div class='tall'>
        <PhotoFigure photo={featured[0]} sizes='(max-width: 720px) 100vw, 40vw' />
      </div>
      <div class='rest'>
        {featured.slice(1).map((photo) => (
          <PhotoFigure photo={photo} sizes='(max-width: 720px) 100vw, 30vw' />
        ))}
      </div>
    </div>
  </section>
  <Lightbox />
</BaseLayout>

<style>
  .hero {
    padding-top: 64px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: end;
    margin-top: 28px;
  }
  h1 {
    grid-column: span 8;
    margin: 0;
    font-size: clamp(40px, 7vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .hero-grid p {
    grid-column: span 4;
    margin: 0;
    line-height: 1.9;
  }
  .hero-photo {
    margin-top: 40px;
  }
  /* Wide crop for the banner */
  .hero-photo :global(.open) {
    aspect-ratio: 21 / 8 !important;
    border-radius: 20px;
  }
  .block {
    margin-top: 96px;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    margin-top: 28px;
  }
  .tall {
    grid-column: span 5;
  }
  .rest {
    grid-column: span 7;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-content: start;
    padding-top: 56px;
  }
  .rest :global(.photo:first-child) {
    grid-column: span 2;
  }
  .block .section-head {
    margin-bottom: 28px;
  }
  .books {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .empty {
    margin: 0;
    padding: 48px 0;
    text-align: center;
  }
  @media (max-width: 860px) {
    h1,
    .hero-grid p,
    .tall,
    .rest {
      grid-column: 1 / -1;
    }
    .rest {
      padding-top: 0;
    }
    .hero-photo :global(.open) {
      aspect-ratio: 4 / 3 !important;
    }
    .books {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .books {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
