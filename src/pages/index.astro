---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import BookCard from '../components/BookCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getBlogPosts, getBookPosts } from '../lib/content';

const books = (await getBookPosts()).slice(0, 3);
const posts = (await getBlogPosts()).slice(0, 6);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class='container hero'>
    <div class='mono muted'>[ 00 — 讀書、寫程式、拍照 ]</div>
    <div class='hero-grid'>
      <h1 class='display'>Notes from <em>the margin</em><span class='accent'>.</span></h1>
      <p class='muted'>{SITE_DESCRIPTION}</p>
    </div>
  </section>

  <section class='container block'>
    <div class='section-head'>
      <h2><em>01</em> 讀書心得</h2>
      <a href='/books' class='mono'>全部書單 →</a>
    </div>
    {
      books.length > 0 ? (
        <div class='books'>
          {books.map((post) => (
            <BookCard post={post} />
          ))}
        </div>
      ) : (
        <p class='empty muted'>第一篇心得正在寫，敬請期待。</p>
      )
    }
  </section>

  <section class='container block'>
    <div class='section-head'>
      <h2><em>02</em> 技術筆記</h2>
      <a href='/blog' class='mono'>全部文章 →</a>
    </div>
    <div>
      {posts.map((post) => <PostRow post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 64px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: end;
    margin-top: 28px;
  }
  h1 {
    grid-column: span 8;
    margin: 0;
    font-size: clamp(56px, 8vw, 100px);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .hero-grid p {
    grid-column: span 4;
    margin: 0;
    line-height: 1.9;
  }
  .block {
    margin-top: 96px;
  }
  .block .section-head {
    margin-bottom: 28px;
  }
  .books {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .empty {
    margin: 0;
    padding: 48px 0;
    text-align: center;
  }
  @media (max-width: 860px) {
    h1,
    .hero-grid p {
      grid-column: 1 / -1;
    }
    .books {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .books {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
