---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { getBlogPosts } from '../lib/content';

const posts = (await getBlogPosts()).slice(0, 3);
---

<BaseLayout title='找不到這一頁' description='這個網址沒有內容，可能已經搬家或拼錯了。'>
  <section class='container'>
    <div class='mono muted'>[ 404 ]</div>
    <h1 class='display'>這一頁寫在<em>別的書頁</em>上<span class='accent'>.</span></h1>
    <p class='muted'>
      找不到這個網址。舊文章搬家後網址換了，或是網址拼錯了。可以從下面的連結繼續逛，或用<a href='/search'>搜尋</a>找找看。
    </p>
    <div class='links'>
      <a class='pill' href='/'>回首頁</a>
      <a class='pill' href='/blog'>技術和生活</a>
      <a class='pill' href='/photos'>攝影</a>
    </div>

    <div class='recent'>
      <div class='section-head'>
        <h2>最近的文章</h2>
      </div>
      {posts.map((post) => <PostRow post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  section {
    padding-top: 64px;
  }
  h1 {
    margin: 20px 0 16px;
    max-width: 820px;
    font-size: clamp(36px, 6vw, 72px);
    line-height: 1.1;
  }
  p {
    max-width: 560px;
    margin: 0;
  }
  p a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }
  .links .pill {
    padding: 8px 16px;
  }
  .recent {
    margin-top: 80px;
  }
</style>
