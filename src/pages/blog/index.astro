---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getBlogPosts } from '../../lib/content';

const posts = await getBlogPosts();
const years = [...new Set(posts.map((p) => p.data.pubDate.getFullYear()))];
---

<BaseLayout title='技術和生活' description='技術上弄懂的事，和生活裡的一些想法'>
  <section class='container'>
    <div class='section-head'>
      <h1 class='display'><em class='accent'>02</em> 技術和生活</h1>
      <span class='mono muted'>{posts.length} 篇</span>
    </div>
    {
      years.map((year) => (
        <div class='year'>
          <h2 class='display'>{year}</h2>
          <div>
            {posts
              .filter((p) => p.data.pubDate.getFullYear() === year)
              .map((post) => (
                <PostRow post={post} />
              ))}
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  section {
    padding-top: 48px;
  }
  h1 {
    margin: 0;
    font-size: clamp(32px, 5vw, 52px);
  }
  .year {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 24px;
    margin-top: 48px;
  }
  .year h2 {
    margin: 16px 0 0;
    font-size: clamp(24px, 3vw, 32px);
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .year {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
