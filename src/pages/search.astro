---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜尋" description="搜尋網站內容">
  <section class="container">
    <div class="section-head">
      <h1 class="display" id="search-title">搜尋</h1>
    </div>
    <div id="search"></div>
    <noscript><p>搜尋功能需要啟用 JavaScript。</p></noscript>
  </section>
</BaseLayout>

<script>
  import { mountSearch } from '../lib/pagefind';

  // Runs on every ClientRouter navigation; the Pagefind script itself loads only once
  document.addEventListener('astro:page-load', () => {
    const container = document.querySelector<HTMLElement>('#search');
    if (!container) return;
    // 直接開這頁（新分頁、書籤）時，進來就可以直接打字
    mountSearch(container, { labelledBy: 'search-title', autofocus: true });
  });
</script>

<style>
  section {
    padding-top: 48px;
  }
  h1 {
    margin: 0;
    font-size: clamp(32px, 5vw, 52px);
  }
  #search {
    margin-top: 32px;
  }
</style>
