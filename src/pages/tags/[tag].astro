---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getTagIndex } from '../../lib/content';

export async function getStaticPaths() {
  const index = await getTagIndex();
  return [...index].map(([slug, { name, posts }]) => ({
    params: { tag: slug },
    props: { name, posts },
  }));
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`#${name}`} description={`標籤「${name}」的所有文章`}>
  <section class='container'>
    <div class='section-head'>
      <h1 class='display'>#{name}</h1>
      <a href='/tags' class='mono'>全部標籤 →</a>
    </div>
    <div>
      {posts.map((post) => <PostRow post={post} />)}
    </div>
  </section>
</BaseLayout>

<style>
  section {
    padding-top: 48px;
  }
  h1 {
    margin: 0;
    font-size: clamp(32px, 5vw, 52px);
  }
</style>
