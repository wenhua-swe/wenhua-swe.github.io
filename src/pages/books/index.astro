---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookCard from '../../components/BookCard.astro';
import { getBookPosts } from '../../lib/content';

const posts = await getBookPosts();
---

<BaseLayout title='讀書心得' description='讀過的書與一些想法'>
  <section class='container'>
    <div class='section-head'>
      <h1 class='display'><em class='accent'>01</em> 讀書心得</h1>
      <span class='mono muted'>{posts.length} 本</span>
    </div>
    {
      posts.length > 0 ? (
        <div class='books'>
          {posts.map((post) => (
            <BookCard post={post} />
          ))}
        </div>
      ) : (
        <p class='empty muted'>第一篇心得正在寫，敬請期待。</p>
      )
    }
  </section>
</BaseLayout>

<style>
  section {
    padding-top: 48px;
  }
  h1 {
    margin: 0;
    font-size: clamp(40px, 6vw, 64px);
  }
  .books {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px 24px;
    margin-top: 32px;
  }
  .empty {
    padding: 64px 0;
    text-align: center;
  }
  @media (max-width: 860px) {
    .books {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .books {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
