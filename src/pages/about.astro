---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GITHUB_URL, SITE_DESCRIPTION } from '../consts';
---

<BaseLayout title='關於' description='關於 Askie'>
  <section class='container'>
    <div class='section-head'>
      <h1 class='display'>關於</h1>
    </div>
    <div class='prose'>
      <p>{SITE_DESCRIPTION}</p>
      <p>[自我介紹待補：你是誰、在做什麼、關心什麼。]</p>
      <p>
        <a href={GITHUB_URL}>GitHub</a> · <a href='/rss.xml'>RSS 訂閱</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  section {
    padding-top: 48px;
  }
  h1 {
    margin: 0;
    font-size: clamp(40px, 6vw, 64px);
  }
  .prose {
    max-width: 680px;
    margin-top: 32px;
  }
</style>
