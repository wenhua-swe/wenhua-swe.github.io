---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
  <nav class='container' aria-label='主選單'>
    <a href='/' class='logo'>{SITE_TITLE}<span class='accent'>.</span></a>
    <div class='links'>
      <HeaderLink href='/books'>閱讀</HeaderLink>
      <HeaderLink href='/blog'>技術和生活</HeaderLink>
      <HeaderLink href='/photos'>攝影</HeaderLink>
      <HeaderLink href='/tags'>標籤</HeaderLink>
      <HeaderLink href='/about'>關於</HeaderLink>
      <a href='/search' class='search mono'>搜尋</a>
      <button type='button' class='theme-toggle' aria-label='切換深淺色模式'>
        <svg class='icon-moon' viewBox='0 0 24 24' width='18' height='18' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' aria-hidden='true'>
          <path d='M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z'></path>
        </svg>
        <svg class='icon-sun' viewBox='0 0 24 24' width='18' height='18' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' aria-hidden='true'>
          <circle cx='12' cy='12' r='4.5'></circle>
          <path d='M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4'></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  // Runs on every ClientRouter navigation, since the header is swapped with each page
  document.addEventListener('astro:page-load', () => {
    document.querySelector('.theme-toggle')?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  });
</script>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    padding-top: 24px;
    padding-bottom: 24px;
  }
  .logo {
    font-family: var(--font-display);
    font-size: 28px;
    font-style: italic;
    text-decoration: none;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font-size: 15px;
  }
  .search,
  .theme-toggle {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--softline);
    border-radius: 999px;
    text-decoration: none;
  }
  .search {
    padding: 0 14px;
  }
  .theme-toggle {
    justify-content: center;
    min-width: 40px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  @media (max-width: 720px) {
    nav {
      padding-top: 16px;
      padding-bottom: 12px;
    }
    .logo {
      font-size: 24px;
    }
    /* One swipeable row instead of wrapping onto several lines */
    .links {
      flex-wrap: nowrap;
      width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .links > :global(*) {
      flex-shrink: 0;
    }
  }
  .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .icon-sun {
    display: block;
  }
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }
</style>
