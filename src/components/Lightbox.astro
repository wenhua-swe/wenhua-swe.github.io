---
// One shared detail view for every photo button (.open) on the page; include once per page
---

<dialog class='lightbox' aria-label='照片檢視'>
  <div class='frame'>
    <div class='stage' aria-busy='true'>
      <span class='spinner' aria-hidden='true'></span>
      <img class='big' alt='' />
    </div>
    <aside>
      <div class='mono muted' data-field='no'></div>
      <h2 class='display' data-field='title'></h2>
      <p class='description' data-field='description'></p>
      <dl>
        <dt class='mono muted'>分類</dt>
        <dd data-field='category'></dd>
        <dt class='mono muted'>日期</dt>
        <dd data-field='date'></dd>
        <dt class='mono muted'>參數</dt>
        <dd data-field='exposure'></dd>
        <dt class='mono muted'>相機</dt>
        <dd>FUJIFILM X-T5</dd>
      </dl>
      <div class='nav'>
        <button type='button' class='prev mono' aria-label='上一張'>←</button>
        <button type='button' class='next mono' aria-label='下一張'>→</button>
        <form method='dialog'>
          <button class='close mono'>關閉</button>
        </form>
      </div>
    </aside>
  </div>
</dialog>

<script>
  // Runs on every ClientRouter navigation, binding to the new page's photos
  document.addEventListener('astro:page-load', () => {
    const reveal = (img: HTMLImageElement) => img.classList.add('loaded');
    document.querySelectorAll<HTMLImageElement>('.open img').forEach((img) => {
      if (img.complete) reveal(img);
      else img.addEventListener('load', () => reveal(img), { once: true });
    });

    const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
    if (!dialog) return;
    const stage = dialog.querySelector<HTMLElement>('.stage')!;
    const big = dialog.querySelector<HTMLImageElement>('.big')!;
    let current: HTMLButtonElement | undefined;

    // Only photos currently shown (category filters hide the rest)
    const visible = () =>
      [...document.querySelectorAll<HTMLButtonElement>('.open[data-full]')].filter(
        (b) => b.offsetParent !== null,
      );

    // Fetch neighbours in the background so arrow-key switching is instant
    const preload = (button?: HTMLButtonElement) => {
      if (button?.dataset.full) new Image().src = button.dataset.full;
    };

    const showPhoto = (button: HTMLButtonElement) => {
      current = button;
      const src = button.dataset.full ?? '';
      // Hide the previous photo until the new one has loaded, instead of flashing it
      big.classList.remove('ready');
      stage.setAttribute('aria-busy', 'true');
      stage.style.backgroundColor = button.dataset.color ?? '';
      // Size the stage to the photo's shape so landscape shots don't sit in a tall empty box
      stage.style.setProperty('--ratio', button.dataset.ratio ?? '1.5');
      const reveal = () => {
        if (big.getAttribute('src') !== src) return;
        big.classList.add('ready');
        stage.setAttribute('aria-busy', 'false');
      };
      big.onload = reveal;
      big.src = src;
      big.alt = button.dataset.alt ?? '';
      if (big.complete) reveal();

      const list = visible();
      const index = list.indexOf(button);
      preload(list[(index + 1) % list.length]);
      preload(list[(index - 1 + list.length) % list.length]);
      dialog.querySelectorAll<HTMLElement>('[data-field]').forEach((el) => {
        el.textContent = button.dataset[el.dataset.field!] ?? '';
        el.hidden = el.textContent === '';
      });
    };

    const step = (delta: number) => {
      const list = visible();
      if (!current || list.length === 0) return;
      const index = (list.indexOf(current) + delta + list.length) % list.length;
      showPhoto(list[index]);
    };

    document.querySelectorAll<HTMLButtonElement>('.open[data-full]').forEach((button) => {
      button.addEventListener('click', () => {
        showPhoto(button);
        dialog.showModal();
      });
    });
    dialog.querySelector('.prev')?.addEventListener('click', () => step(-1));
    dialog.querySelector('.next')?.addEventListener('click', () => step(1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') step(-1);
      if (event.key === 'ArrowRight') step(1);
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .lightbox {
    /* Shrink-wrap the photo + side panel; dvh keeps iOS Safari's toolbars out of the sum */
    --max-h: 94vh;
    width: fit-content;
    max-width: 96vw;
    max-height: var(--max-h);
    /* Tailwind's reset zeroes margins; auto restores the native centring */
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
  }
  .lightbox::backdrop {
    background: rgba(10, 12, 8, 0.85);
  }
  @supports (height: 100dvh) {
    .lightbox {
      --max-h: 94dvh;
    }
  }
  .frame {
    display: grid;
    grid-template-columns: auto 300px;
    max-height: var(--max-h);
  }
  .stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(calc(96vw - 300px), calc(var(--max-h) * var(--ratio, 1.5)), 1100px);
    aspect-ratio: var(--ratio, 1.5);
    max-height: var(--max-h);
    background: #0a0c08;
    transition: background-color 0.3s;
  }
  .big {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .big.ready {
    opacity: 1;
  }
  .spinner {
    position: absolute;
    width: 28px;
    height: 28px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  .stage[aria-busy='false'] .spinner {
    display: none;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .big,
    .stage {
      transition: none;
    }
    .spinner {
      animation-duration: 2.4s;
    }
  }
  aside {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px 28px;
    overflow-y: auto;
  }
  h2 {
    margin: 0;
    font-size: 32px;
    line-height: 1.2;
  }
  .description {
    margin: 0;
    font-size: 15px;
    line-height: 1.9;
  }
  .description[hidden] {
    display: none;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    /* Line each label up with its value on the text baseline */
    align-items: baseline;
    gap: 10px 16px;
    margin: 8px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--softline);
    font-size: 14px;
    line-height: 1.6;
  }
  dt {
    font-size: 11px;
  }
  dd {
    margin: 0;
  }
  .nav {
    display: flex;
    gap: 8px;
    margin-top: auto;
  }
  .nav form {
    margin-left: auto;
  }
  .nav button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--softline);
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  @media (max-width: 860px) {
    .lightbox {
      width: 96vw;
    }
    /* Photo on top, details scroll underneath, buttons always on screen */
    .frame {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
    }
    .stage {
      width: 100%;
      max-height: 60vh;
      max-height: 60dvh;
    }
    aside {
      min-height: 0;
      padding: 20px 20px 0;
    }
    h2 {
      font-size: 26px;
    }
    .nav {
      position: sticky;
      bottom: 0;
      padding: 12px 0 20px;
      background: var(--bg);
    }
  }
</style>
