---
// One shared detail view for every photo button (.open) on the page; include once per page
---

<dialog class='lightbox' aria-label='照片檢視'>
  <div class='frame'>
    <img class='big' alt='' />
    <aside>
      <div class='mono muted' data-field='no'></div>
      <h2 class='display' data-field='title'></h2>
      <dl>
        <dt class='mono muted'>分類</dt>
        <dd data-field='category'></dd>
        <dt class='mono muted'>日期</dt>
        <dd data-field='date'></dd>
        <dt class='mono muted'>參數</dt>
        <dd data-field='exposure'></dd>
        <dt class='mono muted'>相機</dt>
        <dd>FUJIFILM X-T5</dd>
      </dl>
      <div class='nav'>
        <button type='button' class='prev mono' aria-label='上一張'>←</button>
        <button type='button' class='next mono' aria-label='下一張'>→</button>
        <form method='dialog'>
          <button class='close mono'>關閉</button>
        </form>
      </div>
    </aside>
  </div>
</dialog>

<script>
  const reveal = (img: HTMLImageElement) => img.classList.add('loaded');
  document.querySelectorAll<HTMLImageElement>('.open img').forEach((img) => {
    if (img.complete) reveal(img);
    else img.addEventListener('load', () => reveal(img), { once: true });
  });

  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')!;
  const big = dialog.querySelector<HTMLImageElement>('.big')!;
  let current: HTMLButtonElement | undefined;

  // Only photos currently shown (category filters hide the rest)
  const visible = () =>
    [...document.querySelectorAll<HTMLButtonElement>('.open[data-full]')].filter(
      (b) => b.offsetParent !== null,
    );

  const showPhoto = (button: HTMLButtonElement) => {
    current = button;
    big.src = button.dataset.full ?? '';
    big.alt = button.dataset.alt ?? '';
    dialog.querySelectorAll<HTMLElement>('[data-field]').forEach((el) => {
      el.textContent = button.dataset[el.dataset.field!] ?? '';
    });
  };

  const step = (delta: number) => {
    const list = visible();
    if (!current || list.length === 0) return;
    const index = (list.indexOf(current) + delta + list.length) % list.length;
    showPhoto(list[index]);
  };

  document.querySelectorAll<HTMLButtonElement>('.open[data-full]').forEach((button) => {
    button.addEventListener('click', () => {
      showPhoto(button);
      dialog.showModal();
    });
  });
  dialog.querySelector('.prev')?.addEventListener('click', () => step(-1));
  dialog.querySelector('.next')?.addEventListener('click', () => step(1));
  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') step(-1);
    if (event.key === 'ArrowRight') step(1);
  });
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .lightbox {
    width: min(96vw, 1400px);
    max-width: none;
    max-height: 94vh;
    /* Tailwind's reset zeroes margins; auto restores the native centring */
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
  }
  .lightbox::backdrop {
    background: rgba(10, 12, 8, 0.85);
  }
  .frame {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    max-height: 94vh;
  }
  .big {
    display: block;
    width: 100%;
    height: 94vh;
    max-height: 94vh;
    object-fit: contain;
    background: #0a0c08;
  }
  aside {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 32px 28px;
    overflow-y: auto;
  }
  h2 {
    margin: 0;
    font-size: 32px;
    line-height: 1.2;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px 16px;
    margin: 8px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--softline);
    font-size: 14px;
  }
  dt {
    font-size: 11px;
    line-height: 1.9;
  }
  dd {
    margin: 0;
  }
  .nav {
    display: flex;
    gap: 8px;
    margin-top: auto;
  }
  .nav form {
    margin-left: auto;
  }
  .nav button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--softline);
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  @media (max-width: 860px) {
    .frame {
      grid-template-columns: minmax(0, 1fr);
    }
    .big {
      height: auto;
      max-height: 60vh;
    }
    aside {
      padding: 20px;
    }
  }
</style>
