---
import { GITHUB_URL, LINKEDIN_URL } from '../consts';

const today = new Date();
---

<footer class='mono muted'>
  © {today.getFullYear()} WEN-HUA LIN · <a href='/rss.xml'>RSS</a> · <a href={GITHUB_URL} target='_blank' rel='noopener noreferrer'>GITHUB<span class='sr-only'>（另開新分頁）</span></a> · <a href={LINKEDIN_URL} target='_blank' rel='noopener noreferrer'>LINKEDIN<span class='sr-only'>（另開新分頁）</span></a>
</footer>

<style>
  footer {
    margin-top: 96px;
    padding: 28px var(--gutter);
    border-top: 1px solid var(--line);
    text-align: center;
    font-size: 12px;
  }
</style>
