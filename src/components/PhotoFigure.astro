---
import { Picture, getImage } from 'astro:assets';
import { exposure, type Photo } from '../data/photos';

interface Props {
  photo: Photo;
  // The `sizes` attribute: how wide the photo renders, so phones get small files
  sizes: string;
  caption?: boolean;
  eager?: boolean;
}

const { photo, sizes, caption = true, eager = false } = Astro.props;
const full = await getImage({ src: photo.image, width: 2000, format: 'webp' });
---

<figure class='photo'>
  <button
    type='button'
    class='open'
    data-full={full.src}
    data-alt={photo.alt}
    aria-label={`放大檢視：${photo.alt}`}
    style={`background-color: ${photo.color}; aspect-ratio: ${photo.image.width} / ${photo.image.height};`}
  >
    <Picture
      src={photo.image}
      alt={photo.alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding='async'
    />
  </button>
  {
    caption && (
      <figcaption class='mono muted'>
        {photo.date.replaceAll('-', '.')} · {exposure(photo)}
      </figcaption>
    )
  }
</figure>

<style>
  .photo {
    margin: 0;
  }
  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    cursor: zoom-in;
  }
  .open :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity 0.6s ease,
      transform 0.6s ease;
  }
  /* Fade in once loaded; without JS images simply show */
  :global(.js) .open :global(img:not(.loaded)) {
    opacity: 0;
  }
  .open:hover :global(img) {
    transform: scale(1.02);
  }
  figcaption {
    margin-top: 8px;
    font-size: 11px;
  }
</style>
