---
import { Picture, getImage } from 'astro:assets';
import { exposure, type Photo } from '../data/photos';

// A single large photo (e.g. the home banner) that opens in the shared Lightbox
interface Props {
  photo: Photo;
  // The `sizes` attribute: how wide the photo renders, so phones get small files
  sizes: string;
  eager?: boolean;
}

const { photo, sizes, eager = false } = Astro.props;
const full = await getImage({ src: photo.image, width: 2000, format: 'webp', quality: 88 });
---

<figure class='photo'>
  <button
    type='button'
    class='open'
    data-full={full.src}
    data-alt={photo.alt}
    data-title={photo.title}
    data-description={photo.description ?? ''}
    data-no={photo.no}
    data-category={photo.category}
    data-date={photo.date.replaceAll('-', '.')}
    data-exposure={exposure(photo)}
    aria-label={`${photo.title}，查看大圖`}
    style={`background-color: ${photo.color};`}
  >
    <Picture
      src={photo.image}
      alt={photo.alt}
      formats={['avif', 'webp']}
      widths={[640, 1024, 1600, 2400]}
      sizes={sizes}
      quality={85}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding='async'
    />
  </button>
</figure>

<style>
  .photo {
    margin: 0;
  }
  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    overflow: hidden;
    cursor: pointer;
  }
  .open :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.6s ease;
  }
  :global(.js) .open :global(img:not(.loaded)) {
    opacity: 0;
  }
</style>
