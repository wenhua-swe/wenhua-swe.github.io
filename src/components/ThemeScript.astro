---
// Runs before first paint so the page never flashes the wrong theme
---

<script is:inline>
  (() => {
    let theme;
    try {
      theme = localStorage.getItem('theme');
    } catch {}
    if (theme !== 'light' && theme !== 'dark') {
      theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.dataset.theme = theme;
    // Lets CSS hide images until they fade in, only when JS can reveal them
    document.documentElement.classList.add('js');

    // ClientRouter swaps in the next page's <html> attributes; carry the theme over
    // before the swap so the new page never flashes the other theme
    if (!window.__themeSwapBound) {
      window.__themeSwapBound = true;
      document.addEventListener('astro:before-swap', (event) => {
        const next = event.newDocument.documentElement;
        next.dataset.theme = document.documentElement.dataset.theme;
        next.classList.add('js');
      });
    }
  })();
</script>
