---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { formatDate, readingMinutes, stars, tagUrl, type Post } from '../lib/content';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
const book = post.collection === 'books' ? post.data.book : undefined;
const section = post.collection === 'books' ? '01 — 讀書心得' : '02 — 技術筆記';

// Posts last touched more than two years ago get a "may be outdated" notice
const OUTDATED_AFTER_MS = 2 * 365 * 24 * 60 * 60 * 1000;
const lastTouched = updatedDate ?? pubDate;
const isOutdated = Date.now() - lastTouched.valueOf() > OUTDATED_AFTER_MS;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={title} description={description} image={heroImage}>
  <div class='container intro'>
    <div class='mono muted'>
      [ {section} ] · {formatDate(pubDate)} · 閱讀 {readingMinutes(post.body)} 分鐘
    </div>
    <h1 class='display'>{title}<span class='accent'>.</span></h1>
    {
      updatedDate && (
        <div class='mono muted'>最後更新 {formatDate(updatedDate)}</div>
      )
    }
    {heroImage && <img class='hero' src={heroImage} alt='' width='1200' height='457' />}
  </div>

  <div class='container body'>
    <aside>
      {
        toc.length > 0 && (
          <nav class='toc' aria-label='文章目錄'>
            <span class='mono muted'>目錄</span>
            {toc.map((h) => (
              <a href={`#${h.slug}`} class:list={['toc-link', { sub: h.depth === 3 }]} data-slug={h.slug}>
                {h.text}
              </a>
            ))}
          </nav>
        )
      }
      {
        tags.length > 0 && (
          <div class='tags mono'>
            {tags.map((tag) => (
              <a class='pill' href={tagUrl(tag)}>
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </aside>

    <article>
      {
        book && (
          <p class='book-info'>
            《{book.title}》／{book.author}
            {book.rating && <span class='accent'> {stars(book.rating)}</span>}
          </p>
        )
      }
      {
        isOutdated && (
          <p class='notice'>
            這篇文章寫於 {lastTouched.getFullYear()} 年，部分內容可能已經過時，請斟酌參考。
          </p>
        )
      }
      <div class='prose'>
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<script>
  // Highlight the table-of-contents entry for the section being read
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')].map((a) => [a.dataset.slug, a]),
  );
  if (links.size > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.classList.remove('current'));
          links.get(entry.target.id)?.classList.add('current');
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    links.forEach((_, slug) => {
      const heading = slug && document.getElementById(slug);
      if (heading) observer.observe(heading);
    });
  }
</script>

<style>
  .intro {
    padding-top: 24px;
  }
  h1 {
    margin: 20px 0 24px;
    max-width: 980px;
    font-size: clamp(40px, 6vw, 76px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .hero {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 24px;
    border-radius: 20px;
    object-fit: cover;
  }
  .body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    padding-top: 56px;
  }
  aside {
    grid-column: span 3;
    font-size: 14px;
  }
  aside > * + * {
    margin-top: 24px;
  }
  .toc {
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 16px;
    border-left: 2px solid var(--softline);
  }
  .toc-link {
    color: var(--muted);
    line-height: 1.6;
    text-decoration: none;
  }
  .toc-link.sub {
    padding-left: 14px;
  }
  .toc-link.current {
    color: var(--accent);
    font-weight: 600;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
  }
  article {
    grid-column: span 7;
    min-width: 0;
  }
  article > .notice,
  article > .book-info {
    margin-bottom: 32px;
  }
  .book-info {
    margin-top: 0;
    font-family: var(--font-display);
    font-size: 20px;
  }
  @media (max-width: 960px) {
    aside,
    article {
      grid-column: 1 / -1;
    }
    .toc {
      position: static;
    }
  }
</style>
