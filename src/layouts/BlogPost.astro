---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import { formatDate, getSeriesNav, postUrl, readingMinutes, stars, tagUrl, type Post } from '../lib/content';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
const book = post.collection === 'books' ? post.data.book : undefined;
const section = post.collection === 'books' ? '01 — 閱讀筆記' : '02 — 技術和生活';

// Posts last touched more than two years ago get a "may be outdated" notice
const OUTDATED_AFTER_MS = 2 * 365 * 24 * 60 * 60 * 1000;
const lastTouched = updatedDate ?? pubDate;
const isOutdated = Date.now() - lastTouched.valueOf() > OUTDATED_AFTER_MS;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const series = await getSeriesNav(post);
---

<BaseLayout title={title} description={description} image={heroImage}>
  <div class='container intro'>
    <div class='mono muted'>
      [ {section} ] · {formatDate(pubDate)} · 閱讀 {readingMinutes(post.body)} 分鐘
    </div>
    <h1 class='display'>{title}<span class='accent'>.</span></h1>
    {
      updatedDate && (
        <div class='mono muted'>最新編輯日期 {formatDate(updatedDate)}</div>
      )
    }
    {heroImage && <img class='hero' src={heroImage} alt='' width='1200' height='457' />}
  </div>

  <div class='container body'>
    <aside>
      <div class='rail'>
      {
        toc.length > 0 && (
          <nav class='toc' aria-label='文章目錄'>
            <span class='mono muted'>目錄</span>
            {toc.map((h) => (
              <a href={`#${h.slug}`} class:list={['toc-link', { sub: h.depth === 3 }]} data-slug={h.slug}>
                {h.text}
              </a>
            ))}
          </nav>
        )
      }
      {
        tags.length > 0 && (
          <div class='tags mono'>
            {tags.map((tag) => (
              <a class='pill' href={tagUrl(tag)}>
                #{tag}
              </a>
            ))}
          </div>
        )
      }
      </div>
    </aside>

    <article>
      {
        book && (
          <p class='book-info'>
            《{book.title}》／{book.author}
            {book.rating && <span class='accent'> {stars(book.rating)}</span>}
          </p>
        )
      }
      {
        isOutdated && (
          <p class='notice'>
            這篇文章寫於 {lastTouched.getFullYear()} 年，部分內容可能已經過時，請斟酌參考。
          </p>
        )
      }
      <div class='prose'>
        <slot />
      </div>
      {
        series && series.total > 1 && (
          <nav class='series' aria-labelledby='series-heading'>
            <p id='series-heading' class='series-head mono muted'>
              <span>系列文章</span>
              <a href={tagUrl(series.name)}>{series.name}</a>
              <span aria-hidden='true'>{series.position} / {series.total}</span>
              <span class='sr-only'>第 {series.position} 篇，共 {series.total} 篇</span>
            </p>
            <ul>
              {series.prev && (
                <li class='prev'>
                  <a href={postUrl(series.prev)} rel='prev'>
                    <span class='mono muted'>← 上一篇</span>
                    <span class='series-title'>{series.prev.data.title}</span>
                  </a>
                </li>
              )}
              {series.next && (
                <li class='next'>
                  <a href={postUrl(series.next)} rel='next'>
                    <span class='mono muted'>下一篇 →</span>
                    <span class='series-title'>{series.next.data.title}</span>
                  </a>
                </li>
              )}
            </ul>
          </nav>
        )
      }
      <Comments />
    </article>
  </div>
</BaseLayout>

<script>
  // Runs on every ClientRouter navigation into a post
  document.addEventListener('astro:page-load', () => {
    // Highlight the table-of-contents entry for the section being read
    const links = new Map(
      [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')].map((a) => [a.dataset.slug, a]),
    );
    if (links.size > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            links.forEach((a) => a.classList.remove('current'));
            links.get(entry.target.id)?.classList.add('current');
          }
        },
        { rootMargin: '0px 0px -70% 0px' },
      );
      links.forEach((_, slug) => {
        const heading = slug && document.getElementById(slug);
        if (heading) observer.observe(heading);
      });
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    }
  });
</script>

<style>
  .intro {
    padding-top: 24px;
  }
  h1 {
    margin: 20px 0 24px;
    max-width: 980px;
    font-size: clamp(28px, 4.2vw, 52px);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .hero {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 24px;
    border-radius: 20px;
    object-fit: cover;
  }
  .body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    padding-top: 56px;
  }
  aside {
    grid-column: span 3;
    font-size: 14px;
  }
  /* ToC and tags stick together while the article scrolls */
  .rail {
    position: sticky;
    top: 24px;
    max-height: calc(100vh - 48px);
    overflow-y: auto;
  }
  .rail > * + * {
    margin-top: 24px;
  }
  .toc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-left: 16px;
    border-left: 2px solid var(--softline);
  }
  .toc-link {
    color: var(--muted);
    line-height: 1.6;
    text-decoration: none;
  }
  .toc-link.sub {
    padding-left: 14px;
  }
  .toc-link.current {
    color: var(--accent);
    font-weight: 600;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
  }
  article {
    grid-column: span 7;
    min-width: 0;
  }
  article > .notice,
  article > .book-info {
    margin-bottom: 32px;
  }
  .series {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--softline);
  }
  .series-head {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0 0 16px;
    font-size: 13px;
  }
  .series-head a {
    color: var(--accent);
    text-underline-offset: 3px;
  }
  .series ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .series a[rel] {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 14px 16px;
    border: 1px solid var(--softline);
    border-radius: 12px;
    color: var(--fg);
    text-decoration: none;
  }
  .series a[rel]:hover {
    border-color: var(--accent);
  }
  .series a[rel]:hover .series-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .series .mono {
    font-size: 12px;
  }
  .series .next {
    grid-column: 2;
    text-align: right;
  }
  .series-title {
    line-height: 1.5;
  }
  .book-info {
    margin-top: 0;
    font-family: var(--font-display);
    font-size: 20px;
  }
  @media (max-width: 960px) {
    aside,
    article {
      grid-column: 1 / -1;
    }
    .rail {
      position: static;
      max-height: none;
    }
  }
  @media (max-width: 560px) {
    .series ul {
      grid-template-columns: 1fr;
    }
    .series .next {
      grid-column: auto;
      text-align: left;
    }
  }
</style>
